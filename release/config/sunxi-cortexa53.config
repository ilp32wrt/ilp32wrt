# ILP32Wrt release configuration for sunxi/cortexa53 (diffconfig seed for build-release.sh, which adds
# CONFIG_VERSION_NUMBER and CONFIG_VERSION_CODE). Applied with "make defconfig". Allwinner (Cortex-A53): every device
# of the target, each with its own root file system, as in the official OpenWrt builds; not tested on
# hardware.
CONFIG_TARGET_sunxi=y
CONFIG_TARGET_sunxi_cortexa53=y
CONFIG_TARGET_MULTI_PROFILE=y
CONFIG_TARGET_ALL_PROFILES=y
CONFIG_TARGET_PER_DEVICE_ROOTFS=y
CONFIG_DEVEL=y
CONFIG_TOOLCHAINOPTS=y
CONFIG_AARCH64_ABI_ILP32=y
# official OpenWrt LP64 packages in /opt/lp64 (ILP32 packages come from the ILP32Wrt repository)
# CONFIG_PACKAGE_apk-lp64 is not set
# ucode (fw4, LuCI), lucihttp, ucode-mod-html and json-c compiled with clang (llvm-ilp32): fw4 reload 7%
# faster than with GCC on the OpenWrt One, the same memory
CONFIG_CLANG_ILP32=y
CONFIG_CLANG_ILP32_SELECTED=y
CONFIG_CLANG_ILP32_PACKAGES="ucode lucihttp ucode-mod-html json-c"
# the web interface, as in the official OpenWrt images
CONFIG_PACKAGE_luci=y
# not the official OpenWrt build: own name and links, no official download or package repository
CONFIG_IMAGEOPT=y
CONFIG_VERSIONOPT=y
CONFIG_VERSION_DIST="ILP32Wrt"
CONFIG_VERSION_REPO="https://downloads.ilp32.org/ilp32wrt/releases/%V"
CONFIG_VERSION_REPO_PACKAGES="https://downloads.ilp32.org/ilp32wrt/releases/packages-25.12"
CONFIG_VERSION_APK_NO_BUILD_KEY=y
# all kernel modules, so that the kernel of the image accepts the kmods of the package repository
CONFIG_ALL_KMODS=y
CONFIG_VERSION_HOME_URL="https://github.com/ilp32-a64/ilp32wrt"
CONFIG_VERSION_MANUFACTURER="ILP32-A64"
CONFIG_VERSION_MANUFACTURER_URL="https://github.com/ilp32-a64"
CONFIG_VERSION_BUG_URL="https://github.com/ilp32-a64/ilp32wrt/issues"
CONFIG_VERSION_SUPPORT_URL="https://github.com/ilp32-a64/ilp32wrt"
CONFIG_VERSION_FIRMWARE_URL="https://github.com/ilp32-a64/ilp32wrt/releases"
# no package feed, so no package signing keys in the image (neither the official one nor the build's)
# CONFIG_SIGNED_PACKAGES is not set
# the build user and host must not end up in the kernel version string
CONFIG_KERNEL_BUILD_USER="ilp32"
CONFIG_KERNEL_BUILD_DOMAIN="ilp32-a64"
# kernel options and modules selected by packages of the repository, to keep the kernel the same
CONFIG_PACKAGE_kmod-fs-afs=m
CONFIG_PACKAGE_kmod-rxrpc=m
