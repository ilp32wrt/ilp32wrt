# ILP32Wrt release configuration for mediatek/mt7622 (diffconfig seed for build-release.sh, which adds
# CONFIG_VERSION_NUMBER and CONFIG_VERSION_CODE). Applied with "make defconfig". MediaTek MT7622: every device
# of the target, each with its own root file system, as in the official OpenWrt builds; not tested on
# hardware.
CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_mt7622=y
CONFIG_TARGET_MULTI_PROFILE=y
CONFIG_TARGET_ALL_PROFILES=y
CONFIG_TARGET_PER_DEVICE_ROOTFS=y
CONFIG_DEVEL=y
CONFIG_TOOLCHAINOPTS=y
CONFIG_AARCH64_ABI_ILP32=y
# official OpenWrt LP64 packages in /opt/lp64 (ILP32 packages come from the ILP32Wrt repository)
# CONFIG_PACKAGE_apk-lp64 is not set
# ucode (fw4, LuCI), lucihttp, ucode-mod-html and json-c compiled with clang (llvm-ilp32): fw4 reload 7%
# faster than with GCC on the OpenWrt One, the same memory
CONFIG_CLANG_ILP32=y
CONFIG_CLANG_ILP32_SELECTED=y
CONFIG_CLANG_ILP32_PACKAGES="ucode lucihttp ucode-mod-html json-c"
# the web interface, as in the official OpenWrt images
CONFIG_PACKAGE_luci=y
# not the official OpenWrt build: own name and links, no official download or package repository
CONFIG_IMAGEOPT=y
CONFIG_VERSIONOPT=y
CONFIG_VERSION_DIST="ILP32Wrt"
CONFIG_VERSION_REPO="https://downloads.ilp32.org/ilp32wrt/releases/%V"
CONFIG_VERSION_REPO_PACKAGES="https://downloads.ilp32.org/ilp32wrt/releases/packages-25.12"
CONFIG_VERSION_APK_NO_BUILD_KEY=y
# all kernel modules, so that the kernel of the image accepts the kmods of the package repository
CONFIG_ALL_KMODS=y
CONFIG_VERSION_HOME_URL="https://github.com/ilp32wrt/ilp32wrt"
CONFIG_VERSION_MANUFACTURER="ILP32-A64"
CONFIG_VERSION_MANUFACTURER_URL="https://github.com/ilp32-a64"
CONFIG_VERSION_BUG_URL="https://github.com/ilp32wrt/ilp32wrt/issues"
CONFIG_VERSION_SUPPORT_URL="https://github.com/ilp32wrt/ilp32wrt"
CONFIG_VERSION_FIRMWARE_URL="https://github.com/ilp32wrt/ilp32wrt/releases"
# packages are not signed by the build: the repository is signed separately and the image trusts only its
# fixed key (build-release.sh adds release/keys/ilp32wrt-apk.pem)
# CONFIG_SIGNED_PACKAGES is not set
# the build user and host must not end up in the kernel version string
CONFIG_KERNEL_BUILD_USER="ilp32"
CONFIG_KERNEL_BUILD_DOMAIN="ilp32-a64"
# kernel options and modules selected by packages of the repository, to keep the kernel the same
CONFIG_PACKAGE_kmod-fs-afs=m
CONFIG_PACKAGE_kmod-rxrpc=m
# target packages of the package repository (bin/targets/<target>/<subtarget>/packages, as in the official
# repository): built for this target like the full armsr build makes them for armsr
CONFIG_PACKAGE_arptables-nft=m
CONFIG_PACKAGE_atm-aread=m
CONFIG_PACKAGE_atm-atmaddr=m
CONFIG_PACKAGE_atm-atmdiag=m
CONFIG_PACKAGE_atm-atmdump=m
CONFIG_PACKAGE_atm-atmloop=m
CONFIG_PACKAGE_atm-atmsigd=m
CONFIG_PACKAGE_atm-atmswitch=m
CONFIG_PACKAGE_atm-atmtcp=m
CONFIG_PACKAGE_atm-awrite=m
CONFIG_PACKAGE_atm-bus=m
CONFIG_PACKAGE_atm-debug-tools=m
CONFIG_PACKAGE_atm-diagnostics=m
CONFIG_PACKAGE_atm-esi=m
CONFIG_PACKAGE_atm-ilmid=m
CONFIG_PACKAGE_atm-ilmidiag=m
CONFIG_PACKAGE_atm-lecs=m
CONFIG_PACKAGE_atm-les=m
CONFIG_PACKAGE_atm-mpcd=m
CONFIG_PACKAGE_atm-saaldump=m
CONFIG_PACKAGE_atm-sonetdiag=m
CONFIG_PACKAGE_atm-svc_recv=m
CONFIG_PACKAGE_atm-svc_send=m
CONFIG_PACKAGE_atm-tools=m
CONFIG_PACKAGE_atm-ttcp_atm=m
CONFIG_PACKAGE_atm-zeppelin=m
CONFIG_PACKAGE_block-mount=m
CONFIG_PACKAGE_blockd=m
CONFIG_PACKAGE_br2684ctl=m
CONFIG_PACKAGE_comgt=m
CONFIG_PACKAGE_comgt-directip=m
CONFIG_PACKAGE_comgt-ncm=m
CONFIG_PACKAGE_dropbearconvert=m
CONFIG_PACKAGE_ebtables-nft=m
CONFIG_PACKAGE_ip6tables-extra=m
CONFIG_PACKAGE_ip6tables-mod-nat=m
CONFIG_PACKAGE_ip6tables-nft=m
CONFIG_PACKAGE_ip6tables-zz-legacy=m
CONFIG_PACKAGE_iptables-mod-checksum=m
CONFIG_PACKAGE_iptables-mod-cluster=m
CONFIG_PACKAGE_iptables-mod-conntrack-extra=m
CONFIG_PACKAGE_iptables-mod-extra=m
CONFIG_PACKAGE_iptables-mod-filter=m
CONFIG_PACKAGE_iptables-mod-hashlimit=m
CONFIG_PACKAGE_iptables-mod-ipopt=m
CONFIG_PACKAGE_iptables-mod-iprange=m
CONFIG_PACKAGE_iptables-mod-ipsec=m
CONFIG_PACKAGE_iptables-mod-led=m
CONFIG_PACKAGE_iptables-mod-nat-extra=m
CONFIG_PACKAGE_iptables-mod-nflog=m
CONFIG_PACKAGE_iptables-mod-nfqueue=m
CONFIG_PACKAGE_iptables-mod-physdev=m
CONFIG_PACKAGE_iptables-mod-rpfilter=m
CONFIG_PACKAGE_iptables-mod-socket=m
CONFIG_PACKAGE_iptables-mod-tee=m
CONFIG_PACKAGE_iptables-mod-tproxy=m
CONFIG_PACKAGE_iptables-mod-trace=m
CONFIG_PACKAGE_iptables-mod-u32=m
CONFIG_PACKAGE_iptables-nft=m
CONFIG_PACKAGE_iptables-zz-legacy=m
CONFIG_PACKAGE_jool-tools-netfilter=m
CONFIG_PACKAGE_libatomic=m
CONFIG_PACKAGE_libip4tc=m
CONFIG_PACKAGE_libip6tc=m
CONFIG_PACKAGE_libiptext=m
CONFIG_PACKAGE_libiptext-nft=m
CONFIG_PACKAGE_libiptext6=m
CONFIG_PACKAGE_libstdcpp=m
CONFIG_PACKAGE_linux-atm=m
CONFIG_PACKAGE_qosify=m
CONFIG_PACKAGE_snapshot-tool=m
CONFIG_PACKAGE_umbim=m
CONFIG_PACKAGE_uqmi=m
CONFIG_PACKAGE_xtables-legacy=m
CONFIG_PACKAGE_xtables-nft=m
