From: liviyifan <344781483+liviyifan@users.noreply.github.com>
Date: Sat, 24 Oct 2026 11:51:16 +0800
Subject: [PATCH] arm64: uapi: keep __BITS_PER_LONG 64 for the AArch32 compat
 vDSO

The AArch32 compat vDSO (COMPAT_VDSO) is built from the arm64 headers with
an arm compiler (CROSS_COMPILE_COMPAT), which defines neither __LP64__ nor
__ILP32__, so asm/bitsperlong.h stopped it with #error and COMPAT_VDSO could
not be built with GCC.

Use 32 only for AArch64 ILP32 (__aarch64__ and __ILP32__) and 64 otherwise,
as before the ILP32 change.
---
 arch/arm64/include/uapi/asm/bitsperlong.h | 11 ++++++-----
 1 file changed, 6 insertions(+), 5 deletions(-)

--- a/arch/arm64/include/uapi/asm/bitsperlong.h
+++ b/arch/arm64/include/uapi/asm/bitsperlong.h
@@ -17,13 +17,14 @@
 #ifndef __ASM_BITSPERLONG_H
 #define __ASM_BITSPERLONG_H
 
-#if defined(__LP64__)
-/* Assuming __LP64__ will be defined for native ELF64's and not for ILP32. */
-#  define __BITS_PER_LONG 64
-#elif defined(__ILP32__)
+#if defined(__aarch64__) && defined(__ILP32__)
 #  define __BITS_PER_LONG 32
 #else
-#  error "Neither LP64 nor ILP32: unsupported ABI in asm/bitsperlong.h"
+/*
+ * LP64. The AArch32 compat vDSO is built from these headers with an arm
+ * compiler (neither __LP64__ nor __ILP32__); it gets 64, as it always has.
+ */
+#  define __BITS_PER_LONG 64
 #endif
 
 #include <asm-generic/bitsperlong.h>
