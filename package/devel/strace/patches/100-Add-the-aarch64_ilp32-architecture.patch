diff --git a/src/linux/aarch64_ilp32/arch_defs_.h b/src/linux/aarch64_ilp32/arch_defs_.h
new file mode 100644
index 0000000..3f4d0a1
--- /dev/null
+++ b/src/linux/aarch64_ilp32/arch_defs_.h
@@ -0,0 +1,12 @@
+/*
+ * AArch64 ILP32: architecture definitions.
+ *
+ * SPDX-License-Identifier: LGPL-2.1-or-later
+ */
+
+/*
+ * A 32-bit ABI on the AArch64 instruction set: 32-bit long and pointers,
+ * 32-bit kernel long, the generic 32-bit syscall table, AArch64 registers.
+ * Only ILP32 tracees are supported by an ILP32 strace.
+ */
+#define PERSONALITY0_AUDIT_ARCH { AUDIT_ARCH_AARCH64ILP32, 0 }
