diff --git a/src/linux/aarch64_ilp32/set_error.c b/src/linux/aarch64_ilp32/set_error.c
new file mode 100644
index 0000000..d4bb912
--- /dev/null
+++ b/src/linux/aarch64_ilp32/set_error.c
@@ -0,0 +1,19 @@
+/*
+ * AArch64 ILP32: syscall result tampering.
+ *
+ * SPDX-License-Identifier: LGPL-2.1-or-later
+ */
+
+static int
+arch_set_error(struct tcb *tcp)
+{
+	aarch64_regs.regs[0] = (int64_t) -(int32_t) tcp->u_error;
+	return set_regs(tcp->pid);
+}
+
+static int
+arch_set_success(struct tcb *tcp)
+{
+	aarch64_regs.regs[0] = (int64_t) (int32_t) tcp->u_rval;
+	return set_regs(tcp->pid);
+}
