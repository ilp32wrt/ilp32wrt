diff --git a/src/linux/aarch64_ilp32/arch_regs.c b/src/linux/aarch64_ilp32/arch_regs.c
new file mode 100644
index 0000000..29f120b
--- /dev/null
+++ b/src/linux/aarch64_ilp32/arch_regs.c
@@ -0,0 +1,11 @@
+/*
+ * AArch64 ILP32: register set, the same as LP64 (NT_PRSTATUS).
+ *
+ * SPDX-License-Identifier: LGPL-2.1-or-later
+ */
+
+static struct user_pt_regs aarch64_regs;
+
+#define ARCH_REGS_FOR_GETREGSET	aarch64_regs
+#define ARCH_PC_REG		aarch64_regs.pc
+#define ARCH_SP_REG		aarch64_regs.sp
diff --git a/src/linux/aarch64_ilp32/get_error.c b/src/linux/aarch64_ilp32/get_error.c
new file mode 100644
index 0000000..573c468
--- /dev/null
+++ b/src/linux/aarch64_ilp32/get_error.c
@@ -0,0 +1,21 @@
+/*
+ * AArch64 ILP32: syscall result.
+ *
+ * SPDX-License-Identifier: LGPL-2.1-or-later
+ */
+
+#include "negated_errno.h"
+
+static void
+arch_get_error(struct tcb *tcp, const bool check_errno)
+{
+	/* x0 holds a sign-extended 32-bit result. */
+	const kernel_ulong_t x0 = (uint32_t) aarch64_regs.regs[0];
+
+	if (check_errno && is_negated_errno(x0)) {
+		tcp->u_rval = -1;
+		tcp->u_error = -x0;
+	} else {
+		tcp->u_rval = x0;
+	}
+}
diff --git a/src/linux/aarch64_ilp32/get_scno.c b/src/linux/aarch64_ilp32/get_scno.c
new file mode 100644
index 0000000..a8e223c
--- /dev/null
+++ b/src/linux/aarch64_ilp32/get_scno.c
@@ -0,0 +1,13 @@
+/*
+ * AArch64 ILP32: syscall number.
+ *
+ * SPDX-License-Identifier: LGPL-2.1-or-later
+ */
+
+/* Return codes: 1 - ok, 0 - ignore, other - error. */
+static int
+arch_get_scno(struct tcb *tcp)
+{
+	tcp->scno = aarch64_regs.regs[8];
+	return 1;
+}
diff --git a/src/linux/aarch64_ilp32/get_syscall_args.c b/src/linux/aarch64_ilp32/get_syscall_args.c
new file mode 100644
index 0000000..431d42c
--- /dev/null
+++ b/src/linux/aarch64_ilp32/get_syscall_args.c
@@ -0,0 +1,21 @@
+/*
+ * AArch64 ILP32: syscall arguments.
+ *
+ * SPDX-License-Identifier: LGPL-2.1-or-later
+ */
+
+/*
+ * Arguments are 32-bit, the kernel ignores the upper halves of x0-x5.
+ * Return -1 on error or 1 on success (never 0!).
+ */
+static int
+arch_get_syscall_args(struct tcb *tcp)
+{
+	tcp->u_arg[0] = (uint32_t) aarch64_regs.regs[0];
+	tcp->u_arg[1] = (uint32_t) aarch64_regs.regs[1];
+	tcp->u_arg[2] = (uint32_t) aarch64_regs.regs[2];
+	tcp->u_arg[3] = (uint32_t) aarch64_regs.regs[3];
+	tcp->u_arg[4] = (uint32_t) aarch64_regs.regs[4];
+	tcp->u_arg[5] = (uint32_t) aarch64_regs.regs[5];
+	return 1;
+}
