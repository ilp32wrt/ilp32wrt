diff --git a/src/linux/aarch64_ilp32/syscallent.h b/src/linux/aarch64_ilp32/syscallent.h
new file mode 100644
index 0000000..9c4bfe3
--- /dev/null
+++ b/src/linux/aarch64_ilp32/syscallent.h
@@ -0,0 +1,14 @@
+/*
+ * AArch64 ILP32: syscall table.
+ *
+ * SPDX-License-Identifier: LGPL-2.1-or-later
+ */
+
+/*
+ * The generic 32-bit table (kernel: scripts/syscall.tbl with the
+ * "common 32 time32 stat64 memfd_secret" ABIs, compat entry points).
+ * mmap2 takes the offset in 4096-byte units, 84 is sync_file_range2.
+ */
+#define ARCH_WANT_SYNC_FILE_RANGE2 1
+#define sys_ARCH_mmap sys_mmap_4koff
+#include "../32/syscallent.h"
