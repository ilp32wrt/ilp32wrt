diff --git a/configure.ac b/configure.ac
index ad12d20..8b083a1 100644
--- a/configure.ac
+++ b/configure.ac
@@ -69,11 +69,17 @@ karch_m32=
 karch_mx32=
 case "$host_cpu" in
 aarch64*)
-	arch=aarch64
 	karch=arm64
-	arch_m32=arm
-	cc_flags_m32=
-	AC_DEFINE([AARCH64], 1, [Define for the AArch64 architecture.])
+	AC_COMPILE_IFELSE([AC_LANG_PROGRAM([[#ifndef __ILP32__
+# error not ILP32
+#endif]], [[]])], [arch=aarch64_ilp32], [arch=aarch64])
+	if test "$arch" = "aarch64"; then
+		arch_m32=arm
+		cc_flags_m32=
+		AC_DEFINE([AARCH64], 1, [Define for the AArch64 architecture.])
+	else
+		AC_DEFINE([AARCH64_ILP32], 1, [Define for the AArch64 ILP32 ABI.])
+	fi
 	;;
 alpha*)
 	arch=alpha
