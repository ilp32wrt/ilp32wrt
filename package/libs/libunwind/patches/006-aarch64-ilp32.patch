From: liviyifan <344781483+liviyifan@users.noreply.github.com>
Subject: [PATCH] aarch64: support the ILP32 ABI

AArch64 ILP32 (aarch64-linux-gnu_ilp32, aarch64-linux-musl_ilp32): 64-bit registers, 32-bit
pointers, ELF32 objects.

- configure/Makefile.am/tdep: use the ELF32 helper, 4-byte DWARF addresses; libunwind-aarch64
  links the configured ELF helper (elf64 on LP64 as before); Ginit uses elf_w().
- uc_mcontext is at 0xa0 in ucontext_t (uc_flags, uc_link and uc_stack are 20 bytes); the
  sigcontext is unchanged. Static asserts check the offsets against unw_tdep_context_t and the
  C library ucontext_t.
- elfxx: find the IP range as Elf_W (Addr) and return it as unw_word_t (different widths).
- GCC sign-extends a pointer converted to a wider integer: convert through uintptr_t in
  unw_tdep_getcontext and DWARF_REG_LOC/DWARF_FPREG_LOC (stack addresses >= 2 GiB).
---
diff --git a/configure.ac b/configure.ac
index 14762b8..41a6591 100644
--- a/configure.ac
+++ b/configure.ac
@@ -365,10 +365,17 @@ AM_CONDITIONAL(OS_FREEBSD, expr x$target_os : xfreebsd >/dev/null)
 AM_CONDITIONAL(OS_QNX, expr x$target_os : xnto-qnx >/dev/null)
 AM_CONDITIONAL(OS_SOLARIS, expr x$target_os : xsolaris >/dev/null)
 
+AS_IF([test x$target_arch = xaarch64],
+      [AC_COMPILE_IFELSE([AC_LANG_PROGRAM([[#ifndef __ILP32__
+#error LP64
+#endif]])], [aarch64_ilp32=yes], [aarch64_ilp32=no])])
 AC_MSG_CHECKING([for ELF helper width])
 AS_CASE([${target_arch}],
         [arm|hppa|ppc32|x86|sh],           [use_elf32=yes; AC_MSG_RESULT([32])],
-        [aarch64|ia64|ppc64|x86_64|s390x], [use_elf64=yes; AC_MSG_RESULT([64])],
+        [aarch64], [AS_IF([test x$aarch64_ilp32 = xyes],
+                          [use_elf32=yes; AC_MSG_RESULT([32])],
+                          [use_elf64=yes; AC_MSG_RESULT([64])])],
+        [ia64|ppc64|x86_64|s390x],         [use_elf64=yes; AC_MSG_RESULT([64])],
         [mips|riscv|loongarch64],          [use_elfxx=yes; AC_MSG_RESULT([xx])],
         [AC_MSG_ERROR([Unknown ELF target: ${target_arch}])]
 )
diff --git a/include/libunwind-aarch64.h b/include/libunwind-aarch64.h
index 7751e4e..c351526 100644
--- a/include/libunwind-aarch64.h
+++ b/include/libunwind-aarch64.h
@@ -243,7 +243,7 @@ typedef ucontext_t unw_tdep_context_t;
 #elif defined(__QNX__)
 # define UNW_BASE register uint64_t unw_base __asm__ ("x0") = (uint64_t) unw_ctx->uc_mcontext.cpu.gpr;
 #else
-# define UNW_BASE register uint64_t unw_base __asm__ ("x0") = (uint64_t) unw_ctx->uc_mcontext.regs;
+# define UNW_BASE register uint64_t unw_base __asm__ ("x0") = (uint64_t) (uintptr_t) unw_ctx->uc_mcontext.regs;
 #endif
 
 #define unw_tdep_getcontext(uc) ({					\
diff --git a/include/tdep-aarch64/libunwind_i.h b/include/tdep-aarch64/libunwind_i.h
index 5a516e4..5b38973 100644
--- a/include/tdep-aarch64/libunwind_i.h
+++ b/include/tdep-aarch64/libunwind_i.h
@@ -34,7 +34,13 @@ WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.  */
 #include <libunwind.h>
 #include <stdatomic.h>
 
-#include "elf64.h"
+#ifdef __ILP32__
+/* AArch64 ILP32: ELF32 objects, 4-byte DWARF addresses (DW_EH_PE_absptr, DW_OP_addr). */
+# include "elf32.h"
+# define dwarf_addr_size(as) 4
+#else
+# include "elf64.h"
+#endif
 #include "mempool.h"
 #include "dwarf.h"
 
@@ -124,10 +130,10 @@ dwarf_get_uc(const struct dwarf_cursor *cursor)
 # define DWARF_IS_NULL_LOC(l)   (DWARF_GET_LOC (l) == 0)
 # define DWARF_LOC(r, t)        ((dwarf_loc_t) { .val = (r) })
 # define DWARF_IS_REG_LOC(l)    0
-# define DWARF_REG_LOC(c,r)     (DWARF_LOC((unw_word_t)                      \
+# define DWARF_REG_LOC(c,r)     (DWARF_LOC((unw_word_t) (uintptr_t)          \
                                  tdep_uc_addr(dwarf_get_uc(c), (r)), 0))
 # define DWARF_MEM_LOC(c,m)     DWARF_LOC ((m), 0)
-# define DWARF_FPREG_LOC(c,r)   (DWARF_LOC((unw_word_t)                      \
+# define DWARF_FPREG_LOC(c,r)   (DWARF_LOC((unw_word_t) (uintptr_t)          \
                                  tdep_uc_addr(dwarf_get_uc(c), (r)), 0))
 
 static inline int
diff --git a/src/Makefile.am b/src/Makefile.am
index 641cf44..84ce9c2 100644
--- a/src/Makefile.am
+++ b/src/Makefile.am
@@ -465,7 +465,7 @@ libunwind_aarch64_la_LDFLAGS =                 \
 	-version-info $(SOVERSION)
 libunwind_aarch64_la_LIBADD =                  \
 	libunwind-dwarf-generic.la             \
-	libunwind-elf64.la                     \
+	$(libunwind_elf_libs)                  \
 	$(libunwind_libadd)
 
 ### target ARMv7:
diff --git a/src/aarch64/Ginit.c b/src/aarch64/Ginit.c
index 6986dbb..215a2f7 100644
--- a/src/aarch64/Ginit.c
+++ b/src/aarch64/Ginit.c
@@ -217,7 +217,7 @@ get_static_proc_name (unw_addr_space_t as, unw_word_t ip,
                       char *buf, size_t buf_len, unw_word_t *offp,
                       void *arg)
 {
-  return _Uelf64_get_proc_name (as, getpid (), ip, buf, buf_len, offp);
+  return elf_w (get_proc_name) (as, getpid (), ip, buf, buf_len, offp);
 }
 
 static unw_word_t empty_ptrauth_mask(unw_addr_space_t addr_space_unused, void *as_arg_unused)
@@ -228,7 +228,7 @@ static unw_word_t empty_ptrauth_mask(unw_addr_space_t addr_space_unused, void *a
 static int
 get_static_elf_filename (unw_addr_space_t as, unw_word_t ip, char *buf, size_t buf_len, unw_word_t *offp, void *arg)
 {
-  return _Uelf64_get_elf_filename(as, getpid(), ip, buf, buf_len, offp);
+  return elf_w (get_elf_filename) (as, getpid(), ip, buf, buf_len, offp);
 }
 
 HIDDEN void
diff --git a/src/aarch64/Gstep.c b/src/aarch64/Gstep.c
index 6725b1e..963d7a4 100644
--- a/src/aarch64/Gstep.c
+++ b/src/aarch64/Gstep.c
@@ -29,6 +29,19 @@ WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.  */
 #include "ucontext_i.h"
 #include "unwind_i.h"
 
+#if defined(__linux__)
+#include <stddef.h>
+#include <ucontext.h>
+_Static_assert (offsetof (unw_tdep_context_t, uc_mcontext) == UC_MCONTEXT_OFF,
+                "UC_MCONTEXT_OFF does not match unw_tdep_context_t");
+_Static_assert (offsetof (ucontext_t, uc_mcontext) == UC_MCONTEXT_OFF,
+                "UC_MCONTEXT_OFF does not match the C library ucontext_t");
+_Static_assert (offsetof (unw_tdep_context_t, uc_mcontext.sp)
+                - offsetof (unw_tdep_context_t, uc_mcontext) == SC_SP_OFF, "SC_SP_OFF");
+_Static_assert (offsetof (unw_tdep_context_t, uc_mcontext.pc)
+                - offsetof (unw_tdep_context_t, uc_mcontext) == SC_PC_OFF, "SC_PC_OFF");
+#endif
+
 static const int WSIZE = sizeof (unw_word_t);
 
 /* Recognise PLT entries such as:
diff --git a/src/aarch64/ucontext_i.h b/src/aarch64/ucontext_i.h
index 2f3bc09..8cc023e 100644
--- a/src/aarch64/ucontext_i.h
+++ b/src/aarch64/ucontext_i.h
@@ -39,7 +39,11 @@ WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.  */
 
 #elif defined(__linux__)
 
+#ifdef __ILP32__
+#define	UC_MCONTEXT_OFF			0xa0
+#else
 #define	UC_MCONTEXT_OFF			0xb0
+#endif
 #define	SC_GPR_OFF			0x08
 
 #define	SC_X29_OFF			0x0f0
diff --git a/src/elfxx.c b/src/elfxx.c
index e7b2d56..59289e4 100644
--- a/src/elfxx.c
+++ b/src/elfxx.c
@@ -658,18 +658,19 @@ elf_w (get_proc_ip_range_in_image) (unw_addr_space_t as, struct elf_image *ei,
 {
   Elf_W (Addr) load_offset;
   Elf_W (Addr) min_dist = ~(Elf_W (Addr))0;
+  Elf_W (Addr) start_ip = 0, end_ip = 0;
   int ret;
 
   load_offset = elf_w (get_load_offset) (ei, segbase);
-  ret = elf_w (lookup_ip_range) (as, ip, ei, load_offset, start, end, &min_dist);
+  ret = elf_w (lookup_ip_range) (as, ip, ei, load_offset, &start_ip, &end_ip, &min_dist);
 
   /* If the ELF image has MiniDebugInfo embedded in it, look up the symbol in
      there as well and replace the previously found if it is closer. */
   struct elf_image mdi;
   if (elf_w (extract_minidebuginfo) (ei, &mdi))
     {
-      int ret_mdi = elf_w (lookup_ip_range) (as, ip, &mdi, load_offset, start,
-                                             end, &min_dist);
+      int ret_mdi = elf_w (lookup_ip_range) (as, ip, &mdi, load_offset, &start_ip,
+                                             &end_ip, &min_dist);
 
       /* Closer symbol was found (possibly truncated). */
       if (ret_mdi == 0 || ret_mdi == -UNW_ENOMEM)
@@ -682,6 +683,8 @@ elf_w (get_proc_ip_range_in_image) (unw_addr_space_t as, struct elf_image *ei,
 
   if (min_dist >= ei->size)
     return -UNW_ENOINFO;                /* not found */
+  *start = start_ip;
+  *end = end_ip;
   return ret;
 }
 
