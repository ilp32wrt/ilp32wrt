From: liviyifan <344781483+liviyifan@users.noreply.github.com>
Subject: [PATCH] sljit: handle AArch64 ILP32 as a 32-bit architecture

With the ILP32 ABI (aarch64-*-linux-gnu_ilp32, -musl_ilp32) long and
pointers have 32 bits, while the registers and the instruction set are
those of AArch64. sljit took such a build for a 64-bit one: a machine
word (sljit_sw) was a 4-byte long in C, but the generated code moved
8-byte words. The JIT read and wrote the C data structures with the
wrong sizes and crashed in the first compiled match.

The ARM64 backend gets a second mode, selected by __ILP32__
(SLJIT_ARM_64_ILP32). sljit_sw is 32 bits wide there and the target is a
32-bit architecture for the users of sljit:

- A register holds a zero-extended 32-bit value. Word operations use the
  32-bit (W) form of the instructions, like the SLJIT_32 operations on
  LP64; sign extensions stop at 32 bits.
- Memory operands: a base register with a small offset is used as it
  is. A base with an index, a large offset or an absolute address is
  added in 32 bits first, because either part can be a pointer above
  2 GiB or a negative offset.
- The arguments received from C code and the value returned by a called
  function are zero-extended: the ABI leaves their upper 32 bits
  undefined. The instruction for the return value follows every call,
  and SLJIT_GET_RETURN_ADDRESS adds its size.
- Saved registers and the stack frame keep their 64-bit sizes.
- Jump and address distances are computed in 64-bit integers; the jump
  flags fit into 32 bits.
- SLJIT_LMUL_UW/SW, the conversions between words and floats,
  sljit_emit_fcopy (register pairs), sljit_emit_fset64, register pairs
  in sljit_emit_mem, atomic operations and SIMD lane moves follow the
  rules of a 32-bit architecture.

LP64 builds do not change: pcre2_jit_compile.o has the same .text,
.rodata and .data as before for the 8, 16 and 32 bit libraries.

The regression test of sljit (test_src of the bundled sljit commit)
passes on ILP32 in QEMU (cortex-a53 and max).

Signed-off-by: liviyifan <344781483+liviyifan@users.noreply.github.com>
---
 deps/sljit/sljit_src/sljitConfigInternal.h |  13 +-
 deps/sljit/sljit_src/sljitLir.c            |   5 +
 deps/sljit/sljit_src/sljitNativeARM_64.c   | 424 ++++++++++++++++-----
 3 files changed, 353 insertions(+), 89 deletions(-)

diff --git a/deps/sljit/sljit_src/sljitConfigInternal.h b/deps/sljit/sljit_src/sljitConfigInternal.h
index c052434..2a509e3 100644
--- a/deps/sljit/sljit_src/sljitConfigInternal.h
+++ b/deps/sljit/sljit_src/sljitConfigInternal.h
@@ -345,6 +345,14 @@ typedef signed short int sljit_s16;
 typedef unsigned int sljit_u32;
 typedef signed int sljit_s32;
 
+/* AArch64 with the ILP32 ABI: the instruction set and the registers are
+   64 bit wide, long and pointers have 32 bits. It is handled as a 32 bit
+   architecture: a machine word (sljit_sw) is 32 bit, and the ARM64
+   backend uses the 32 bit form of the instructions for words. */
+#if (defined SLJIT_CONFIG_ARM_64 && SLJIT_CONFIG_ARM_64) && defined(__ILP32__)
+#define SLJIT_ARM_64_ILP32 1
+#endif
+
 /* Machine word type. Enough for storing a pointer.
      32 bit for 32 bit machines.
      64 bit for 64 bit machines. */
@@ -354,7 +362,7 @@ typedef signed int sljit_s32;
 typedef unsigned int sljit_uw;
 typedef int sljit_sw;
 #elif !(defined SLJIT_CONFIG_X86_64 && SLJIT_CONFIG_X86_64) \
-	&& !(defined SLJIT_CONFIG_ARM_64 && SLJIT_CONFIG_ARM_64) \
+	&& (!(defined SLJIT_CONFIG_ARM_64 && SLJIT_CONFIG_ARM_64) || (defined SLJIT_ARM_64_ILP32 && SLJIT_ARM_64_ILP32)) \
 	&& !(defined SLJIT_CONFIG_PPC_64 && SLJIT_CONFIG_PPC_64) \
 	&& !(defined SLJIT_CONFIG_MIPS_64 && SLJIT_CONFIG_MIPS_64) \
 	&& !(defined SLJIT_CONFIG_RISCV_64 && SLJIT_CONFIG_RISCV_64) \
@@ -665,7 +673,8 @@ SLJIT_API_FUNC_ATTRIBUTE sljit_sw sljit_exec_offset(void *code);
 #define SLJIT_TMP_DEST_REG SLJIT_TMP_R0
 #define SLJIT_TMP_OPT_REG SLJIT_TMP_R1
 #define SLJIT_TMP_DEST_FREG SLJIT_TMP_FR0
-#define SLJIT_LOCALS_OFFSET_BASE (2 * (sljit_s32)sizeof(sljit_sw))
+/* The frame pointer and the return address: two 64 bit registers. */
+#define SLJIT_LOCALS_OFFSET_BASE (2 * 8)
 #define SLJIT_MASKED_SHIFT 1
 #define SLJIT_MASKED_SHIFT32 1
 #define SLJIT_UPPER_BITS_IGNORED 1
diff --git a/deps/sljit/sljit_src/sljitLir.c b/deps/sljit/sljit_src/sljitLir.c
index 633e794..310cdc1 100644
--- a/deps/sljit/sljit_src/sljitLir.c
+++ b/deps/sljit/sljit_src/sljitLir.c
@@ -234,7 +234,12 @@ struct sljit_extended_label {
 #	define PATCH_B32	0x080
 #	define PATCH_ABS48	0x100
 #	define PATCH_ABS64	0x200
+#if (defined SLJIT_ARM_64_ILP32 && SLJIT_ARM_64_ILP32)
+/* The flags have 32 bits. */
+#	define JUMP_SIZE_SHIFT	26
+#else /* !SLJIT_ARM_64_ILP32 */
 #	define JUMP_SIZE_SHIFT	58
+#endif /* SLJIT_ARM_64_ILP32 */
 #	define JUMP_MAX_SIZE	((sljit_uw)5)
 #endif /* SLJIT_CONFIG_ARM_64 */
 
diff --git a/deps/sljit/sljit_src/sljitNativeARM_64.c b/deps/sljit/sljit_src/sljitNativeARM_64.c
index dabbd3b..67aeb86 100644
--- a/deps/sljit/sljit_src/sljitNativeARM_64.c
+++ b/deps/sljit/sljit_src/sljitNativeARM_64.c
@@ -38,6 +38,31 @@ SLJIT_API_FUNC_ATTRIBUTE const char* sljit_get_platform_name(void)
 /* Length of an instruction word */
 typedef sljit_u32 sljit_ins;
 
+#if (defined SLJIT_ARM_64_ILP32 && SLJIT_ARM_64_ILP32)
+/* ILP32: sljit_sw is 32 bit wide, the registers are 64 bit wide. Every
+   register holds a zero extended 32 bit value: word operations use the
+   32 bit (W) form of the instructions, in the same way as the operations
+   with SLJIT_32 on LP64, addresses are computed with 32 bit additions,
+   and the values received from C code (arguments, return values) are
+   zero extended first, since their upper 32 bits are not defined.
+   Addresses and immediates are still computed as 64 bit integers here. */
+typedef long long sljit_sw64;
+typedef unsigned long long sljit_uw64;
+#define IS_32BIT_OP(flags)	1
+/* Added to the address computing instructions. */
+#define ADDR_W_OP		((sljit_ins)1 << 31)
+#else /* !SLJIT_ARM_64_ILP32 */
+typedef sljit_sw sljit_sw64;
+typedef sljit_uw sljit_uw64;
+#define IS_32BIT_OP(flags)	((flags) & SLJIT_32)
+#define ADDR_W_OP		0
+#endif /* SLJIT_ARM_64_ILP32 */
+
+/* The size of a saved register. */
+#define REG_SSIZE		8
+#define GET_SAVED_REGS_SIZE(scratches, saveds, extra) \
+	(GET_SAVED_REGISTERS_SIZE(scratches, saveds, extra) * (REG_SSIZE / SSIZE_OF(sw)))
+
 #define TMP_ZERO	(0)
 
 #define TMP_REG1	(SLJIT_NUMBER_OF_REGISTERS + 2)
@@ -205,7 +230,7 @@ static sljit_s32 push_inst(struct sljit_compiler *compiler, sljit_ins ins)
 	return SLJIT_SUCCESS;
 }
 
-static SLJIT_INLINE sljit_s32 emit_imm64_const(struct sljit_compiler *compiler, sljit_s32 dst, sljit_uw imm)
+static SLJIT_INLINE sljit_s32 emit_imm64_const(struct sljit_compiler *compiler, sljit_s32 dst, sljit_uw64 imm)
 {
 	FAIL_IF(push_inst(compiler, MOVZ | RD(dst) | ((sljit_ins)(imm & 0xffff) << 5)));
 	FAIL_IF(push_inst(compiler, MOVK | RD(dst) | (((sljit_ins)(imm >> 16) & 0xffff) << 5) | (1 << 21)));
@@ -215,7 +240,7 @@ static SLJIT_INLINE sljit_s32 emit_imm64_const(struct sljit_compiler *compiler,
 
 static SLJIT_INLINE sljit_ins* detect_jump_type(struct sljit_jump *jump, sljit_ins *code_ptr, sljit_ins *code, sljit_sw executable_offset)
 {
-	sljit_sw diff;
+	sljit_sw64 diff;
 	sljit_uw target_addr;
 	sljit_uw jump_addr = (sljit_uw)code_ptr;
 	sljit_uw orig_addr = jump->addr;
@@ -235,7 +260,7 @@ static SLJIT_INLINE sljit_ins* detect_jump_type(struct sljit_jump *jump, sljit_i
 			jump_addr = (sljit_uw)(code + orig_addr);
 	}
 
-	diff = (sljit_sw)target_addr - (sljit_sw)SLJIT_ADD_EXEC_OFFSET(jump_addr, executable_offset);
+	diff = (sljit_sw64)target_addr - (sljit_sw64)(sljit_uw)SLJIT_ADD_EXEC_OFFSET(jump_addr, executable_offset);
 
 	if (jump->flags & IS_COND) {
 		diff += SSIZE_OF(ins);
@@ -288,7 +313,7 @@ static SLJIT_INLINE sljit_sw mov_addr_get_length(struct sljit_jump *jump, sljit_
 {
 	sljit_uw addr;
 	sljit_uw jump_addr = (sljit_uw)code_ptr;
-	sljit_sw diff;
+	sljit_sw64 diff;
 	SLJIT_UNUSED_ARG(executable_offset);
 
 	SLJIT_ASSERT(jump->flags < ((sljit_uw)4 << JUMP_SIZE_SHIFT));
@@ -301,7 +326,7 @@ static SLJIT_INLINE sljit_sw mov_addr_get_length(struct sljit_jump *jump, sljit_
 			jump_addr = (sljit_uw)(code + jump->addr);
 	}
 
-	diff = (sljit_sw)addr - (sljit_sw)SLJIT_ADD_EXEC_OFFSET(jump_addr, executable_offset);
+	diff = (sljit_sw64)addr - (sljit_sw64)(sljit_uw)SLJIT_ADD_EXEC_OFFSET(jump_addr, executable_offset);
 
 	if (diff <= 0xfffff && diff >= -0x100000) {
 		jump->flags |= PATCH_B;
@@ -332,21 +357,21 @@ static SLJIT_INLINE sljit_sw mov_addr_get_length(struct sljit_jump *jump, sljit_
 
 static SLJIT_INLINE void generate_jump_or_mov_addr(struct sljit_jump *jump, sljit_sw executable_offset)
 {
-	sljit_sw addr = (sljit_sw)((jump->flags & JUMP_ADDR) ? jump->u.target : jump->u.label->u.addr);
+	sljit_sw64 addr = (sljit_sw64)((jump->flags & JUMP_ADDR) ? jump->u.target : jump->u.label->u.addr);
 	sljit_ins* buf_ptr = (sljit_ins*)jump->addr;
 	sljit_u32 dst;
 	SLJIT_UNUSED_ARG(executable_offset);
 
 	if (!(jump->flags & JUMP_MOV_ADDR)) {
 		if (jump->flags & PATCH_COND) {
-			addr = (addr - (sljit_sw)SLJIT_ADD_EXEC_OFFSET(buf_ptr, executable_offset)) >> 2;
+			addr = (addr - (sljit_sw64)(sljit_uw)SLJIT_ADD_EXEC_OFFSET(buf_ptr, executable_offset)) >> 2;
 			SLJIT_ASSERT(addr <= 0x3ffff && addr >= -0x40000);
 			buf_ptr[0] = (buf_ptr[0] & ~(sljit_ins)0xffffe0) | (sljit_ins)((addr & 0x7ffff) << 5);
 			return;
 		}
 
 		if (jump->flags & PATCH_B) {
-			addr = (addr - (sljit_sw)SLJIT_ADD_EXEC_OFFSET(buf_ptr, executable_offset)) >> 2;
+			addr = (addr - (sljit_sw64)(sljit_uw)SLJIT_ADD_EXEC_OFFSET(buf_ptr, executable_offset)) >> 2;
 			SLJIT_ASSERT(addr <= 0x1ffffff && addr >= -0x2000000);
 			buf_ptr[0] = ((jump->flags & IS_BL) ? BL : B) | (sljit_ins)(addr & 0x3ffffff);
 			return;
@@ -355,7 +380,7 @@ static SLJIT_INLINE void generate_jump_or_mov_addr(struct sljit_jump *jump, slji
 		dst = (buf_ptr[0] >> 5) & 0x1f;
 
 		if (jump->flags & PATCH_B32) {
-			addr -= (sljit_sw)SLJIT_ADD_EXEC_OFFSET(buf_ptr, executable_offset) & ~(sljit_sw)0xfff;
+			addr -= (sljit_sw64)(sljit_uw)SLJIT_ADD_EXEC_OFFSET(buf_ptr, executable_offset) & ~(sljit_sw)0xfff;
 			SLJIT_ASSERT(addr <= 0xfffff000l && addr >= -0x100000000l);
 			buf_ptr[0] = ADRP | (((sljit_ins)(addr >> 12) & 0x3) << 29) | (((sljit_ins)(addr >> 14) & 0x7ffff) << 5) | dst;
 			buf_ptr[1] = ADDI | dst | (dst << 5) | ((sljit_ins)(addr & 0xfff) << 10);
@@ -365,14 +390,14 @@ static SLJIT_INLINE void generate_jump_or_mov_addr(struct sljit_jump *jump, slji
 		dst = *buf_ptr;
 
 		if (jump->flags & PATCH_B) {
-			addr -= (sljit_sw)SLJIT_ADD_EXEC_OFFSET(buf_ptr, executable_offset);
+			addr -= (sljit_sw64)(sljit_uw)SLJIT_ADD_EXEC_OFFSET(buf_ptr, executable_offset);
 			SLJIT_ASSERT(addr <= 0xfffff && addr >= -0x100000);
 			buf_ptr[0] = ADR | (((sljit_ins)addr & 0x3) << 29) | (((sljit_ins)(addr >> 2) & 0x7ffff) << 5) | dst;
 			return;
 		}
 
 		if (jump->flags & PATCH_B32) {
-			addr -= ((sljit_sw)SLJIT_ADD_EXEC_OFFSET(buf_ptr, executable_offset)) & ~(sljit_sw)0xfff;
+			addr -= ((sljit_sw64)(sljit_uw)SLJIT_ADD_EXEC_OFFSET(buf_ptr, executable_offset)) & ~(sljit_sw)0xfff;
 			SLJIT_ASSERT(addr <= 0xffffffffl && addr >= -0x100000000l);
 			buf_ptr[0] = ADRP | (((sljit_ins)(addr >> 12) & 0x3) << 29) | (((sljit_ins)(addr >> 14) & 0x7ffff) << 5) | dst;
 			buf_ptr[1] = ADDI | dst | (dst << 5) | ((sljit_ins)(addr & 0xfff) << 10);
@@ -380,8 +405,8 @@ static SLJIT_INLINE void generate_jump_or_mov_addr(struct sljit_jump *jump, slji
 		}
 	}
 
-	SLJIT_ASSERT((jump->flags & (PATCH_ABS48 | PATCH_ABS64)) || (sljit_uw)addr <= (sljit_uw)0xffffffff);
-	SLJIT_ASSERT((jump->flags & PATCH_ABS64) || (sljit_uw)addr <= (sljit_uw)0xffffffffffff);
+	SLJIT_ASSERT((jump->flags & (PATCH_ABS48 | PATCH_ABS64)) || (sljit_uw64)addr <= (sljit_uw64)0xffffffff);
+	SLJIT_ASSERT((jump->flags & PATCH_ABS64) || (sljit_uw64)addr <= (sljit_uw64)0xffffffffffff);
 
 	buf_ptr[0] = MOVZ | (((sljit_ins)addr & 0xffff) << 5) | dst;
 	buf_ptr[1] = MOVK | (((sljit_ins)(addr >> 16) & 0xffff) << 5) | (1 << 21) | dst;
@@ -389,7 +414,7 @@ static SLJIT_INLINE void generate_jump_or_mov_addr(struct sljit_jump *jump, slji
 		buf_ptr[2] = MOVK | (((sljit_ins)(addr >> 32) & 0xffff) << 5) | (2 << 21) | dst;
 
 	if (jump->flags & PATCH_ABS64)
-		buf_ptr[3] = MOVK | ((sljit_ins)((sljit_uw)addr >> 48) << 5) | (3 << 21) | dst;
+		buf_ptr[3] = MOVK | ((sljit_ins)((sljit_uw64)addr >> 48) << 5) | (3 << 21) | dst;
 }
 
 static SLJIT_INLINE sljit_ins *process_extended_label(sljit_ins *code_ptr, struct sljit_extended_label *ext_label)
@@ -406,7 +431,7 @@ static void reduce_code_size(struct sljit_compiler *compiler)
 	SLJIT_NEXT_DEFINE_TYPES;
 	sljit_uw total_size;
 	sljit_uw size_reduce = 0;
-	sljit_sw diff;
+	sljit_sw64 diff;
 
 	label = compiler->labels;
 	jump = compiler->jumps;
@@ -687,11 +712,11 @@ SLJIT_API_FUNC_ATTRIBUTE sljit_s32 sljit_cmp_info(sljit_s32 type)
 
 #define LOGICAL_IMM_CHECK (sljit_ins)0x100
 
-static sljit_ins logical_imm(sljit_sw imm, sljit_u32 len)
+static sljit_ins logical_imm(sljit_sw64 imm, sljit_u32 len)
 {
 	sljit_s32 negated;
 	sljit_u32 ones, right;
-	sljit_uw mask, uimm;
+	sljit_uw64 mask, uimm;
 	sljit_ins ins;
 
 	if (len & LOGICAL_IMM_CHECK) {
@@ -705,14 +730,14 @@ static sljit_ins logical_imm(sljit_sw imm, sljit_u32 len)
 	SLJIT_ASSERT((len == 32 && imm != 0 && imm != -1)
 		|| (len == 16 && (sljit_s32)imm != 0 && (sljit_s32)imm != -1));
 
-	uimm = (sljit_uw)imm;
+	uimm = (sljit_uw64)imm;
 	while (1) {
 		if (len <= 0) {
 			SLJIT_UNREACHABLE();
 			return 0;
 		}
 
-		mask = ((sljit_uw)1 << len) - 1;
+		mask = ((sljit_uw64)1 << len) - 1;
 		if ((uimm & mask) != ((uimm >> len) & mask))
 			break;
 		len >>= 1;
@@ -727,13 +752,13 @@ static sljit_ins logical_imm(sljit_sw imm, sljit_u32 len)
 	}
 
 	if (len < 64)
-		uimm &= ((sljit_uw)1 << len) - 1;
+		uimm &= ((sljit_uw64)1 << len) - 1;
 
 	/* Unsigned right shift. */
 	COUNT_TRAILING_ZERO(uimm, right);
 
 	/* Signed shift. We also know that the highest bit is set. */
-	imm = (sljit_sw)~uimm;
+	imm = (sljit_sw64)~uimm;
 	SLJIT_ASSERT(imm < 0);
 
 	COUNT_TRAILING_ZERO(imm, ones);
@@ -754,9 +779,9 @@ static sljit_ins logical_imm(sljit_sw imm, sljit_u32 len)
 
 #undef COUNT_TRAILING_ZERO
 
-static sljit_s32 load_immediate(struct sljit_compiler *compiler, sljit_s32 dst, sljit_sw simm)
+static sljit_s32 load_immediate64(struct sljit_compiler *compiler, sljit_s32 dst, sljit_sw64 simm)
 {
-	sljit_uw imm = (sljit_uw)simm;
+	sljit_uw64 imm = (sljit_uw64)simm;
 	sljit_u32 i, zeros, ones, first;
 	sljit_ins bitmask;
 
@@ -807,7 +832,7 @@ static sljit_s32 load_immediate(struct sljit_compiler *compiler, sljit_s32 dst,
 		simm >>= 16;
 	}
 
-	simm = (sljit_sw)imm;
+	simm = (sljit_sw64)imm;
 	first = 1;
 	if (ones > zeros) {
 		simm = ~simm;
@@ -843,6 +868,15 @@ static sljit_s32 load_immediate(struct sljit_compiler *compiler, sljit_s32 dst,
 	return SLJIT_SUCCESS;
 }
 
+static SLJIT_INLINE sljit_s32 load_immediate(struct sljit_compiler *compiler, sljit_s32 dst, sljit_sw64 simm)
+{
+#if (defined SLJIT_ARM_64_ILP32 && SLJIT_ARM_64_ILP32)
+	/* A word is zero extended in its register. */
+	simm = (sljit_sw64)(sljit_u32)simm;
+#endif /* SLJIT_ARM_64_ILP32 */
+	return load_immediate64(compiler, dst, simm);
+}
+
 #define ARG1_IMM	0x0010000
 #define ARG2_IMM	0x0020000
 #define INT_OP		0x0040000
@@ -856,7 +890,7 @@ static sljit_s32 load_immediate(struct sljit_compiler *compiler, sljit_s32 dst,
 			dst = TMP_ZERO; \
 	}
 
-static sljit_s32 emit_op_imm(struct sljit_compiler *compiler, sljit_s32 flags, sljit_s32 dst, sljit_sw arg1, sljit_sw arg2)
+static sljit_s32 emit_op_imm(struct sljit_compiler *compiler, sljit_s32 flags, sljit_s32 dst, sljit_sw64 arg1, sljit_sw64 arg2)
 {
 	/* dst must be register, TMP_REG1
 	   arg1 must be register, TMP_REG1, imm
@@ -865,7 +899,7 @@ static sljit_s32 emit_op_imm(struct sljit_compiler *compiler, sljit_s32 flags, s
 	sljit_ins inst_bits;
 	sljit_s32 op = (flags & 0xffff);
 	sljit_s32 reg;
-	sljit_sw imm, nimm;
+	sljit_sw64 imm, nimm;
 
 	if (SLJIT_UNLIKELY((flags & (ARG1_IMM | ARG2_IMM)) == (ARG1_IMM | ARG2_IMM))) {
 		/* Both are immediates. */
@@ -1170,6 +1204,13 @@ set_flags:
 #define INT_SIZE	0x2
 #define WORD_SIZE	0x3
 
+/* The size of a machine word (sljit_sw) in memory. */
+#if (defined SLJIT_ARM_64_ILP32 && SLJIT_ARM_64_ILP32)
+#define SW_SIZE		INT_SIZE
+#else /* !SLJIT_ARM_64_ILP32 */
+#define SW_SIZE		WORD_SIZE
+#endif /* SLJIT_ARM_64_ILP32 */
+
 #define MEM_SIZE_SHIFT(flags) ((sljit_ins)(flags) & 0x3)
 
 static sljit_s32 emit_op_mem(struct sljit_compiler *compiler, sljit_s32 flags, sljit_s32 reg,
@@ -1178,6 +1219,28 @@ static sljit_s32 emit_op_mem(struct sljit_compiler *compiler, sljit_s32 flags, s
 	sljit_u32 shift = MEM_SIZE_SHIFT(flags);
 	sljit_u32 type = (shift << 30);
 
+#if (defined SLJIT_ARM_64_ILP32 && SLJIT_ARM_64_ILP32)
+	if (!(flags & STORE)) {
+		/* Bytes and half words are sign extended to 32 bits only,
+		   SIGNED with WORD_SIZE is the prefetch instruction. */
+		if ((flags & SIGNED) && shift < 2)
+			type |= 0x00c00000;
+		else if ((flags & SIGNED) && shift == 3)
+			type |= 0x00800000;
+		else
+			type |= 0x00400000;
+	}
+
+	SLJIT_ASSERT(arg & SLJIT_MEM);
+
+	if (SLJIT_UNLIKELY(arg & OFFS_REG_MASK)) {
+		/* The sum has 32 bits: either register can hold a pointer
+		   above 2 GiB or a negative offset. */
+		argw &= 0x3;
+		FAIL_IF(push_inst(compiler, (ADD ^ W_OP) | RD(tmp_reg) | RN(arg & REG_MASK) | RM(OFFS_REG(arg)) | ((sljit_ins)argw << 10)));
+		return push_inst(compiler, STRBI | type | RT(reg) | RN(tmp_reg));
+	}
+#else /* !SLJIT_ARM_64_ILP32 */
 	if (!(flags & STORE))
 		type |= (flags & SIGNED) ? 0x00800000 : 0x00400000;
 
@@ -1193,6 +1256,7 @@ static sljit_s32 emit_op_mem(struct sljit_compiler *compiler, sljit_s32 flags, s
 		FAIL_IF(push_inst(compiler, ADD | RD(tmp_reg) | RN(arg & REG_MASK) | RM(OFFS_REG(arg)) | ((sljit_ins)argw << 10)));
 		return push_inst(compiler, STRBI | type | RT(reg) | RN(tmp_reg));
 	}
+#endif /* SLJIT_ARM_64_ILP32 */
 
